# Groq API key (OpenAI-compatible endpoint) used by the orchestrator's LLM calls.
GROQ_API_KEY=gsk_your-key-here

# Model id to use for chat completions.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call this API (frontend dev server, etc).
CORS_ORIGINS=http://localhost:5173
